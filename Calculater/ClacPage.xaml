<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculater.ClacPage"
             Title="ClacPage">
    <VerticalStackLayout>
        <Label Text="" x:Name="lblResult" FontSize="30"/>
        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*" HeightRequest="600" ColumnSpacing="10" RowSpacing="10">
            <Button Text="7" Grid.Row="0" Grid.Column="0" Clicked="ButtonDigit_Clicked" BackgroundColor="Black"/>
            <Button Text="8" Grid.Row="0" Grid.Column="1" Clicked="ButtonDigit_Clicked" BackgroundColor="Black"/>
            <Button Text="9" Grid.Row="0" Grid.Column="2" Clicked="ButtonDigit_Clicked" BackgroundColor="Black"/>
            <Button Text="4" Grid.Row="1" Grid.Column="0" Clicked="ButtonDigit_Clicked" BackgroundColor="Black"/>
            <Button Text="5" Grid.Row="1" Grid.Column="1" Clicked="ButtonDigit_Clicked" BackgroundColor="Black"/>
            <Button Text="6" Grid.Row="1" Grid.Column="2" Clicked="ButtonDigit_Clicked" BackgroundColor="Black"/>
            <Button Text="1" Grid.Row="2" Grid.Column="0" Clicked="ButtonDigit_Clicked" BackgroundColor="Black"/>
            <Button Text="2" Grid.Row="2" Grid.Column="1" Clicked="ButtonDigit_Clicked" BackgroundColor="Black"/>
            <Button Text="3" Grid.Row="2" Grid.Column="2" Clicked="ButtonDigit_Clicked" BackgroundColor="Black"/>
            <Button Text="0" Grid.Row="4" Grid.Column="1" Clicked="ButtonDigit_Clicked" BackgroundColor="Black"/>
            <Button Text="+" Grid.Row="0" Grid.Column="3" Clicked="ButtonOperator_Clicked" BackgroundColor="DarkOrange"/>
            <Button Text="-" Grid.Row="1" Grid.Column="3" Clicked="ButtonOperator_Clicked" BackgroundColor="DarkOrange"/>
            <Button Text="*" Grid.Row="2" Grid.Column="3" Clicked="ButtonOperator_Clicked" BackgroundColor="DarkOrange"/>
            <Button Text="/" Grid.Row="3" Grid.Column="3" Clicked="ButtonOperator_Clicked" BackgroundColor="DarkOrange"/>
            <Button Text="ac" Grid.Row="3" Grid.Column="0" Clicked="ButtonDelete_Clicked" BackgroundColor="Gray"/>
            <Button Text="=" Grid.Row="4" Grid.Column="2" Clicked="ButtonEqual_Clicked" BackgroundColor="DarkOrange"/>
        </Grid>

    </VerticalStackLayout>
</ContentPage>